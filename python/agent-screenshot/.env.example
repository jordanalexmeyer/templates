# Browserbase credentials (required)
# Get these from https://www.browserbase.com/settings
BROWSERBASE_PROJECT_ID=your_browserbase_project_id
BROWSERBASE_API_KEY=your_browserbase_api_key

# Google API key for Gemini models (required)
# Used for both the Stagehand act/extract/observe model and the CUA agent model.
# Passed as model_api_key in the SDK (the env var name differs from the SDK param name).
# Get your key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key
